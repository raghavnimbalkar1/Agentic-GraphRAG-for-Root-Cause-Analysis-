# =============================================================
# Agentic GraphRAG RCA — environment template
# Copy to .env and fill in. Every variable maps 1:1 to a field in
# core/config.py::Settings (pydantic-settings, case-insensitive).
# =============================================================

# ── LLM provider ─────────────────────────────────────────────
# One of: gemini | openai | anthropic | ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite

# API key for the provider you chose (leave the others empty)
GOOGLE_API_KEY=your_google_ai_studio_key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Only used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# ── Neo4j (dual graph store) ─────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# ── Docker (sandbox + telemetry) ─────────────────────────────
# Local dev: unix:///var/run/docker.sock
DOCKER_HOST=unix:///var/run/docker.sock
SOP_EXECUTOR_IMAGE=sop-executor:latest

# ── Agent behaviour ──────────────────────────────────────────
AGENT_MAX_ATTEMPTS=5
ALERT_LISTEN_PORT=8888

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Filesystem paths (relative to project root) ──────────────
SOPS_DIR=sops
AUDIT_DIR=audit
