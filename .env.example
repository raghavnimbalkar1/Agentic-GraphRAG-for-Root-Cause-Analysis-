# =============================================================
# Agentic GraphRAG RCA — environment template
# Copy to .env and fill in. Every variable maps 1:1 to a field in
# core/config.py::Settings (pydantic-settings, case-insensitive).
# =============================================================

# ── LLM provider ─────────────────────────────────────────────
# One of: groq | gemini | openai | anthropic | ollama
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT=30
LLM_MAX_TOKENS=2048

# API key for the provider you chose (leave the others empty)
GROQ_API_KEY=your_groq_api_key
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Only used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# ── Neo4j (dual graph store) ─────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# ── Docker (sandbox + telemetry) ─────────────────────────────
# Local dev: unix:///var/run/docker.sock
DOCKER_HOST=unix:///var/run/docker.sock
SOP_EXECUTOR_IMAGE=sop-executor:latest
VERIFICATION_TIMEOUT=25
# Local controller connectivity must pass the live preflight on your Docker host.
CONTROL_BIND=127.0.0.1
CONTROL_CONTAINER_HOST=host.docker.internal

# ── Agent behaviour ──────────────────────────────────────────
AGENT_MAX_ATTEMPTS=5
ALERT_LISTEN_PORT=8888
OBSERVATION_MAX_AGE=60

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Filesystem paths (relative to project root) ──────────────
SOPS_DIR=sops
AUDIT_DIR=audit
